{
  "name": "nivar",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "seed": "pnpm --filter api seed",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"pnpm --filter api dev\" \"pnpm --filter web dev\"",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter api test"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "packageManager": "pnpm@12.4.2"
}
