{
  "name": "nivar",
  "private": true,
  "scripts": {
    "supabase:env": "node scripts/supabase-env.mjs",
    "supabase:up": "docker compose --env-file supabase/docker/.env up -d --wait",
    "supabase:studio": "docker compose --env-file supabase/docker/.env --profile studio up -d --wait",
    "supabase:down": "docker compose --env-file supabase/docker/.env --profile studio down",
    "supabase:logs": "docker compose --env-file supabase/docker/.env logs -f --tail=100",
    "db:migrate": "bash scripts/db-migrate.sh",
    "setup": "pnpm supabase:env && pnpm supabase:up && pnpm db:migrate && pnpm seed",
    "seed": "pnpm --filter web seed",
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter web test"
  },
  "packageManager": "pnpm@12.4.2"
}
