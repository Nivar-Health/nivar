    "mongoose": "^9.11.1",
    "morgan": "^1.12.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
