# Nivar API configuration (all values have safe dev defaults)
PORT=4100
MONGO_URL=mongodb://localhost:27018/nivar
JWT_SECRET=dev-nivar-secret-change-me
WEB_ORIGIN=http://localhost:3100
# Set to "test" by the test runner; tests use mongodb://localhost:27018/nivar_test
# NODE_ENV=development

# On Vercel (serverless), set MONGO_URL to a hosted MongoDB (for example Atlas) and a strong
# JWT_SECRET in the project settings. WEB_ORIGIN can stay unset: the web app calls the API on
# the same origin through the /api rewrite, so no cross-origin request is made.
