# Supabase project (apps/web/.env.local, git-ignored). Create a project at supabase.com,
# apply the schema with `pnpm supabase db push` and copy the keys from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only (route handlers, seed script). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The API is served by this app under /api, so the browser calls the same origin.
# Set NEXT_PUBLIC_API_URL only when the API runs somewhere else.
# NEXT_PUBLIC_API_URL=

# Customer booking and sign-in are still in development. Set to false to hide "Log in" on the
# public site and redirect /login and /app to /. (The site books by WhatsApp or callback either way.)
# Staff sign-in at /staff/login is unaffected. Read at build time.
NEXT_PUBLIC_BOOKING_ENABLED=true

# Public site origin for share previews (og:image) and canonical links. Defaults to
# https://www.nivarhealth.in, so set it only for a staging domain. Read at build time.
# NEXT_PUBLIC_SITE_URL=

# WhatsApp number for every "WhatsApp us" button and the floating button, with country code
# (919845012345; a bare 10-digit mobile gets 91 added). While unset, WhatsApp buttons are hidden
# and the CTAs fall back to the callback form. Read at build time.
NEXT_PUBLIC_WHATSAPP_NUMBER=
